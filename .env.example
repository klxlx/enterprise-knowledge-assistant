# DashScope API key used by DashScopeEmbeddings and ChatTongyi.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Production uses a dedicated DB role on the local 1Panel PostgreSQL instance.
DATABASE_URL=postgresql+psycopg://robot-rag:your_database_password_here@127.0.0.1:5432/robot_rag
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
CHAT_MODEL=deepseek-v4-pro
# 检索参数：先召回 RAG_RETRIEVAL_K 条，再用 RAG_SCORE_THRESHOLD 过滤不相关的片段。
# 相关度取值 0~1（1 表示完全一致），阈值越高越严格；可按知识库情况调整。
RAG_RETRIEVAL_K=8
RAG_SCORE_THRESHOLD=0.35
# 重排序：对召回的候选做精排，保留 RAG_RERANK_TOP_N 条并按 RAG_RERANK_THRESHOLD 过滤。
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=qwen3.7-text-rerank
RAG_RERANK_TOP_N=3
RAG_RERANK_THRESHOLD=0.3
# 分块：先按标题切章节，再在章节内切到 RAG_CHUNK_SIZE；RAG_PARENT_CHARS 是交给模型的上下文窗口。
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_PARENT_CHARS=1200
# 图片与扫描件的 OCR 模型
RAG_OCR_MODEL=qwen-vl-ocr
# 会话历史：只把最近 RAG_HISTORY_KEEP_TURNS 轮原文交给模型，
# 超过 RAG_HISTORY_SUMMARY_AFTER 条消息后，更早的对话累积到
# RAG_HISTORY_SUMMARY_TRIGGER 条就压缩一次摘要（用便宜的小模型）。
RAG_HISTORY_KEEP_TURNS=4
RAG_HISTORY_SUMMARY_AFTER=10
RAG_HISTORY_SUMMARY_TRIGGER=4
RAG_SUMMARY_MODEL=qwen-flash
# 推理型模型（deepseek-v4-pro 等）会先思考再输出，首字要等几秒到几十秒。
# 设为 true 关掉思考，首字约 1 秒，代价是不再输出推理过程。
RAG_DISABLE_THINKING=true
# 工具调用：一次提问最多允许模型调用几轮工具，超出后强制它直接作答
RAG_MAX_TOOL_ROUNDS=3
# 钉钉文件检索：mock=读 mock/dingtalk/index.json；real=拿到企业应用授权后走真实接口
DINGTALK_MODE=mock
# 真实模式才需要：企业内部应用的 AppKey / AppSecret
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
